# Copy to .env.local and fill in. .env.local is gitignored.

# Public site URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://petroff-avocats.fr

# Email delivery for the contact form (see src/app/contact/actions.ts).
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=contact@petroff-avocats.fr

# Petroff Laravel API, for the admin at /admin. No trailing slash.
# Bearer-token Sanctum: the browser sends no cookies to it, so the backend
# must allow this app's exact origin in CORS (FRONTEND_URL / ADMIN_FRONTEND_URL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
